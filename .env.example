# Khóa API của Anthropic (https://console.anthropic.com) – dùng cho soạn tin và tab Hỏi đáp
ANTHROPIC_API_KEY=
# Model dùng để soạn tin và trả lời hỏi đáp
ANTHROPIC_MODEL=claude-sonnet-5-5
# Số lượt tìm kiếm web tối đa mỗi lần soạn tin
MAX_SEARCHES=40
# Số token tối đa cho câu trả lời
MAX_TOKENS=32000
# Cổng của server.py
PORT=8000
